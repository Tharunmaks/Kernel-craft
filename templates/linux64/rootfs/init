#!/bin/sh
# KernelCraft Linux Forge: PID 1. Mounts the virtual filesystems, runs the
# startup script, then keeps the main app (or a shell) alive on tty1.
export PATH=/usr/bin:/bin:/sbin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /tmp /run
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
hostname -F /etc/hostname 2>/dev/null

[ -x /etc/kc/rc ] && /etc/kc/rc

while true; do
    if [ -x /usr/bin/kcpanel ]; then
        setsid cttyhack /usr/bin/kcpanel
    fi
    setsid cttyhack /bin/sh -l
done
