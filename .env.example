# Copy to .env (never commit .env) and fill in what you use.
# AI provider, first one set wins: Claude, OpenRouter (free models by default), Groq.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional: comma-separated model lists, tried in order
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_CRITIC_MODEL=google/gemma-4-31b-it:free
GROQ_API_KEY=
# Payments (Razorpay dashboard -> API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local development: activate plans without payment when Razorpay is not set
KC_DEV_BILLING=1
