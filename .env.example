# Copy to .env (never commit .env) and fill in what you use.
# AI provider: Claude is used if ANTHROPIC_API_KEY is set, otherwise Groq.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Payments (Razorpay dashboard -> API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local development: activate plans without payment when Razorpay is not set
KC_DEV_BILLING=1
